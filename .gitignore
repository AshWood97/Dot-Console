# Dependencies and temporary developer output
node_modules/
coverage/
.coverage/
*.log
npm-debug.log*
*.tmp
*.swp
.DS_Store

# Environment files may contain secrets
.env
.env.*
!.env.example

# Local state and portable exports must remain outside source control
data/
.data/
.local/
state.json
state.bak
state.json.*
state.bak.*
server.lock/
backups/
exports/
*backup*.json
*BACKUP*.json

# Generated distribution artifacts; inspect an explicit file allowlist
*.tgz
*.zip
dist/
